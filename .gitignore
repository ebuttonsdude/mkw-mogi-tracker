custom-themes*.json

# Generated documentation output and Hugo build caches.
/public/
/website/public/
/website/resources/
/website/.hugo_build.lock

# Private external vision configuration and interrupted writes/backups.
external-vision*.json*
.external-vision-*.tmp

# Generated CI toolchain identity; downloaded tools stay in the runner's local image.
/ci-toolchain.env

# User-owned local course pictures and interrupted atomic writes.
course-images*.json
.course-images-*.tmp

# User-owned Lounge background images and interrupted atomic writes.
overlay-backgrounds*.json
.overlay-backgrounds-*.tmp
